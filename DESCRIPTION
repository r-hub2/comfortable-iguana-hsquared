Package: hsquared
Title: R Interface for Julia-Backed Quantitative-Genetic Models
Version: 0.9.0
Authors@R: c(
    person("Shinichi", "Nakagawa", , "itchyshin@gmail.com", role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0002-7765-5182")),
